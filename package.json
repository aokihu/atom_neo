{
  "name": "atom-neo",
  "version": "1.24.2",
  "type": "module",
  "main": "./dist/node/main.js",
  "exports": {
    ".": {
      "bun": "./dist/node/main.js",
      "node": "./dist/node/main.js",
      "default": "./dist/node/main.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "atom": "./dist/node/main.js"
  },
  "files": [
    "dist/node/main.js"
  ],
  "engines": {
    "node": ">=26",
    "bun": ">=1.4"
  },
  "workspaces": [
    "src/packages/shared",
    "src/packages/core",
    "src/packages/config-tui",
    "src/packages/gateway",
    "src/packages/tui",
    "src/packages/tui-kit"
  ],
  "scripts": {
    "dev": "bun run src/main.ts --sandbox ./sandbox --log=file --log-level=debug --log-file=/tmp/atom-log-$(date +%s).log",
    "dev:gateway": "bun run src/main.ts --mode core-gateway --sandbox ./sandbox --log=file --log-level=debug --log-file=/tmp/atom-log-$(date +%s).log",
    "dev:core": "bun run src/main.ts --mode core --port 3100 --sandbox ./sandbox",
    "config": "bun run src/main.ts --config --sandbox ./sandbox",
    "docs": "bun run docs/server.ts",
    "docs:node": "node docs/server.ts",
    "docs:check": "bun run scripts/check-docs.ts",
    "docs:typecheck": "tsc -p tsconfig.docs.json",
    "test": "bun test",
    "check:size": "bun run scripts/check-code-size.ts",
    "typecheck": "bun run --workspaces typecheck",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "build": "bun run --workspaces build",
    "build:bin": "mkdir -p dist && bun -e 'const{writeFileSync}=require(\"fs\");const pkg=require(\"./package.json\");writeFileSync(\"src/version.ts\",`export const VERSION = \\\"${pkg.version}\\\";\\n`)' && bun build ./src/main.ts --compile --outfile dist/atom --target bun",
    "build:node": "bun build ./src/main.ts --target node --outdir ./dist/node --external '@opentui/*' --banner '#!/usr/bin/env node'",
    "smoke:node": "bun run scripts/node-smoke/run-all.ts",
    "smoke:node:platform": "bun run scripts/node-smoke/run-all.ts platform",
    "smoke:node:release": "bun run scripts/node-smoke/run-all.ts release",
    "smoke:node:package": "bun run scripts/node-smoke/package.ts",
    "prepack": "bun run build:node",
    "prepare": "bash scripts/setup-git-hooks.sh"
  },
  "dependencies": {
    "@opentui/core": "0.8.4",
    "@opentui/react": "0.8.4",
    "react": "^19.2.8",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@ai-sdk/deepseek": "^3.0.84",
    "@ai-sdk/mcp": "^2.0.96",
    "@atom-neo/config-tui": "workspace:*",
    "@atom-neo/core": "workspace:*",
    "@atom-neo/gateway": "workspace:*",
    "@atom-neo/shared": "workspace:*",
    "@atom-neo/tui": "workspace:*",
    "@atom-neo/tui-kit": "workspace:*",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.6",
    "ai": "^7.0.169",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.0",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@opentui/core": "0.8.4",
    "@opentui/react": "0.8.4"
  }
}
