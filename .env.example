# Copy to $SANDBOX/.env
# LLM API Keys (one required)
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...

# Optional: same explicit token on Core and remote TUI; never stored in menu history
# ATOM_ADMIN_TOKEN=your-private-admin-token
# Official Gateway client source index (file or http(s) URL); provided by release/deployment.
# ATOM_GATEWAY_SOURCE_INDEX=https://example.invalid/gateway-source-index.json
